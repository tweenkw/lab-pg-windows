#!/usr/bin/env bash
echo "[pre-commit] Запуск валидации миграций (PowerShell)..."

if [ ! -f "infra/scripts/validate-migrations.ps1" ]; then
    echo "[pre-commit] ОШИБКА: скрипт валидации не найден."
    exit 1
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "infra/scripts/validate-migrations.ps1"
code=$?
if [ $code -eq 0 ]; then
    echo "[pre-commit] Валидация пройдена. Коммит разрешён."
    exit 0
else
    echo ""
    echo "[pre-commit] ОШИБКА: валидация не пройдена (код $code). Коммит ЗАБЛОКИРОВАН."
    exit 1
fi